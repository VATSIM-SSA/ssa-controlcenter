<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" backupGlobals="false" bootstrap="vendor/autoload.php" colors="true" processIsolation="false" stopOnFailure="false" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.3/phpunit.xsd" cacheDirectory=".phpunit.cache" backupStaticProperties="false">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
  </testsuites>
  <php>
    <server name="APP_ENV" value="testing"/>
    <!--
      A key of the suite's own, so the tests do not depend on a developer's
      .env for one.

      Without this, APP_KEY came from whatever .env the machine happened to
      have, and on a machine where the test process cannot read that file 321
      tests error on MissingAppKeyException: every test that makes an HTTP
      request, because the session cookie is encrypted. The suite then looks
      broken rather than unconfigured, which is the worst of both.

      Throwaway and public on purpose. It encrypts nothing but a session cookie
      in an in-memory sqlite database that is discarded at the end of the run,
      and it must never be the key of any deployment.
    -->
    <server name="APP_KEY" value="base64:9qsCTJw6PUhCWeLn7/FCgrnrFwgHipO7LRB1l3cr76w="/>
    <server name="BCRYPT_ROUNDS" value="4"/>
    <server name="CACHE_DRIVER" value="array"/>
    <!--
      MAIL_MAILER, not MAIL_DRIVER. Laravel renamed it in 7.x and config/mail.php
      reads `env('MAIL_MAILER', 'smtp')`, so MAIL_DRIVER overrode nothing: the
      suite fell through to smtp and tests that send mail opened a real SMTP
      connection. Several of them error on "530 Authentication required", which
      is the harmless outcome.

      The harmful one is a machine whose .env holds working Brevo credentials.
      There, `php artisan test` would have SENT the seeded fixtures' mail to
      whatever addresses they carry. MAIL_DRIVER is kept only so an older tool
      reading it is not surprised.
    -->
    <server name="MAIL_MAILER" value="array"/>
    <server name="MAIL_DRIVER" value="array"/>
    <server name="QUEUE_CONNECTION" value="sync"/>
    <server name="SESSION_DRIVER" value="array"/>
    <server name="FILESYSTEM_DISK" value="test"/>
    <server name="DB_CONNECTION" value="sqlite-testing"/>
    <server name="DB_DATABASE" value=":memory:"/>
  </php>
  <source>
    <include>
      <directory>./app</directory>
    </include>
  </source>
</phpunit>
