# ControlCentre staging environment.
#
# TEMPLATE ONLY. Every secret is blank on purpose. This file is committed to a
# PUBLIC repository, so it documents which keys each environment needs and
# nothing else. Real values live only in /srv/apps/cc/staging/.env on the VPS,
# which is never in git.
#
# Copy to /srv/apps/cc/staging/.env on the box, chmod 600, and fill it in there.
#
# Checked against upstream v7.0.0's .env.example. ControlCentre uses NO Redis:
# cache, sessions and queue are all file/sync based, which is why the compose
# file mounts storage/framework/sessions as a volume.

# --- Application -------------------------------------------------
APP_NAME=ControlCentre Staging
APP_TAGLINE=Training Administration
APP_ENV=staging
# the OAuth redirect is derived from this, as <APP_URL>/validate
APP_URL=https://cc-staging.vatssa.com
# never true in production: a 500 would render database credentials
APP_DEBUG=true
# VATSSA is a DIVISION. User.php uses this string as a COLUMN NAME: where(config(app.mode), config(app.owner_code)). Set to subdivision it queries WHERE subdivision = SSA, which matches nobody, and every member check fails division-wide.
APP_MODE=division
# openssl rand -base64 32, prefixed base64:. One per environment, never shared.
APP_KEY=
DEBUGBAR_ENABLED=false
LOG_CHANNEL=stack

# --- Division identity -------------------------------------------
APP_OWNER_NAME=VATSSA
APP_OWNER_NAME_SHORT=SSA
APP_OWNER_CODE=SSA

# --- Branding ----------------------------------------------------
# public/images/logos/. Sidebar is dark, so the white wordmark
APP_LOGO=vatssa.svg
# mail bodies are light, so the dark wordmark
APP_LOGO_MAIL=vatssa-email.png

# --- Database ----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=vatssa-mysql
DB_PORT=3306
DB_DATABASE=cc_staging
DB_USERNAME=cc_staging_user
DB_PASSWORD=

# --- Drivers -----------------------------------------------------
CACHE_DRIVER=file
# sessions are files; the compose volume exists to survive a recreate
SESSION_DRIVER=file
# seven days
SESSION_LIFETIME=10080
# no queue worker runs. Anything ShouldQueue on sync 500s the page.
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
# storage/app/public/files, mounted as a volume
FILESYSTEM_DISK=local

# --- Handover OAuth ----------------------------------------------
OAUTH_URL=https://handover-staging.vatssa.com
# one Passport client per environment. Redirect: https://cc-staging.vatssa.com/validate
OAUTH_ID=
OAUTH_SECRET=

# --- Mail --------------------------------------------------------
# never send real mail from a non-production environment
MAIL_MAILER=log

# --- VATSIM APIs -------------------------------------------------
# LEAVE EMPTY. Optional, and an empty token idles cleanly.
VATSIM_CORE_API_TOKEN=
# LEAVE EMPTY, or point at deploy/mock-vatsim-api once it is deployed.
VATSIM_BOOKING_API_URL=
# LEAVE EMPTY. Never point a non-production environment at the real APIs.
VATSIM_BOOKING_API_TOKEN=

# --- Proxy -------------------------------------------------------
# the chain is Cloudflare -> cloudflared -> Caddy -> container. Nothing else can reach the container, so * is the tunnel, not the internet.
TRUSTED_PROXIES=*


# ---------------------------------------------------------------------------
# Deliberately absent, do not add back:
#
#   REDIS_*            ControlCentre uses no Redis. Cache, session and queue are
#                      file/sync. The keys in the old overlay template came from
#                      another app and did nothing.
#
#   MAIL_ENCRYPTION    Laravel 12 removed it in favour of MAIL_SCHEME. A leftover
#                      MAIL_ENCRYPTION=tls silently kills every send, which is
#                      what broke BMAC on 1 August 2026. If you copy an older
#                      .env forward, delete the line rather than blanking it.
#
# Upstream's config/mail.php currently reads
#   'scheme' => env('MAIL_MAILER', 'smtp'),
# feeding the mailer name into the transport scheme. That is an upstream bug;
# see PATCHES.md, upstream-contrib/mail-scheme. Until it lands, MAIL_MAILER must
# stay 'smtp' on production.
# ---------------------------------------------------------------------------

# --- VATSSA training pipeline -------------------------------------------------
# The bridge the pipeline bot writes through. Generate with:
#   openssl rand -hex 32
#
# LEAVE THIS BLANK HERE. This repository is public; the real value goes in the
# .env on the VPS and nowhere else.
#
# Blank is a working state, not a broken one: the routes exist and refuse
# everything, and the bot degrades into "here is what to click" lines on the
# daily digest. That is how the fork ships before the bot is deployed.
VATSSA_BRIDGE_TOKEN=

# Moodle's webhook secret. Generate the same way:
#   openssl rand -hex 32
#
# SEPARATE FROM THE BRIDGE TOKEN ON PURPOSE. The bridge is 403'd at Caddy so it
# cannot be reached from the internet; Moodle is on the internet. Giving Moodle
# the bridge token would mean opening the bridge, which undoes the one thing
# that makes the bridge safe.
#
# One endpoint sits behind this and it may only write whether somebody has a
# Moodle account. A leak from Moodle costs that one write path.
#
# LEAVE THIS BLANK HERE too. Blank means the endpoint refuses everything, which
# is the correct resting state before Moodle has been set up.
VATSSA_MOODLE_SECRET=

# Discord webhooks, one per audience. Create each in the channel's own
# Integrations settings.
#
# THESE ARE CREDENTIALS. Anybody holding one can post to that channel as the
# bot, so they live in the .env on the VPS and stay blank here -- this
# repository is public.
#
# Blank is silent, not broken: Control Center records that it could not post
# and carries on. Every stage change is on the page and in the automation log
# regardless, so a missing webhook costs a notification, never a step.
VATSSA_DISCORD_EXAMINERS=
VATSSA_DISCORD_EVENTS=
VATSSA_DISCORD_TRAINING=

# Seconds to cache the consolidated roster. The homepage asks every few minutes;
# the underlying data changes hourly at most.
VATSSA_ROSTER_CACHE_SECONDS=300
