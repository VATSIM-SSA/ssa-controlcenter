# ControlCentre dev environment.
#
# TEMPLATE ONLY. Every value is blank on purpose. This file is committed to a
# PUBLIC repository, so it documents which keys each environment needs and
# nothing else. Real values live only in /srv/apps/cc/dev/.env on the VPS,
# which is never in git.
#
# Copy to /srv/apps/cc/dev/.env on the box and fill it in there.

# --- Application -------------------------------------------------
APP_NAME=ControlCentre Dev
APP_ENV=dev
APP_URL=https://cc-dev.vatssa.com
# never true in production: a 500 would render database credentials
APP_DEBUG=true
APP_MODE=
# php artisan key:generate. Rotating it invalidates every session and every encrypted column
APP_KEY=

# --- Division identity -------------------------------------------
APP_OWNER_NAME=VATSSA
APP_OWNER_NAME_SHORT=SSA
APP_OWNER_CODE=SSA

# --- Branding ----------------------------------------------------
# public/images/logos/. Sidebar, so it must be the white wordmark
APP_LOGO=vatssa.svg
# public/images/logos/. Mail bodies are light, so the dark wordmark
APP_LOGO_MAIL=vatssa-email.png

# --- Database ----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Redis -------------------------------------------------------
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=

# --- VATSIM Connect / Handover OAuth -----------------------------
# {oauth_hint}
OAUTH_URL=
OAUTH_ID=
OAUTH_SECRET=

# --- Mail --------------------------------------------------------
# never send real mail from a non-production environment
MAIL_MAILER=log

# --- VATSIM APIs -------------------------------------------------
# LEAVE EMPTY. Both tokens are optional and an empty one idles cleanly.
VATSIM_CORE_API_TOKEN=
# point at deploy/mock-vatsim-api when the integration screens need data
VATSIM_BOOKING_API_URL=
# LEAVE EMPTY. Never point a non-production environment at the real APIs.
VATSIM_BOOKING_API_TOKEN=

# --- Proxy -------------------------------------------------------
# the traffic chain is Cloudflare -> cloudflared -> Caddy -> container, and nothing else can reach the container, so * is the tunnel and not the internet
TRUSTED_PROXIES=*


# ---------------------------------------------------------------------------
# MAIL_ENCRYPTION is deliberately absent.
#
# Laravel 12 removed it in favour of MAIL_SCHEME. A leftover MAIL_ENCRYPTION=tls
# silently kills every send, which is what broke BMAC on 1 August 2026. If you
# are copying an older .env forward, delete that line rather than blanking it.
#
# Note also that upstream's config/mail.php currently reads
# 'scheme' => env('MAIL_MAILER', 'smtp'), feeding the mailer name into the
# transport scheme. That is an upstream bug; see PATCHES.md, contribution
# upstream-contrib/mail-scheme. Until it lands, MAIL_MAILER must stay 'smtp'.
# ---------------------------------------------------------------------------
